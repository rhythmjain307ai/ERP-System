# Example environment variables for the ERP backend
DATABASE_URL="postgresql://postgres:password@localhost:5432/erp_db?schema=public"
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/erp_backend_test?schema=public"
PORT=4000
AUTH_TOKEN_SECRET="development-only-secret"
NODE_ENV=development
PRISMA_TRANSACTION_MAX_WAIT_MS=10000
PRISMA_TRANSACTION_TIMEOUT_MS=30000
