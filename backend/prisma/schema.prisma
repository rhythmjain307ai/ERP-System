// Prisma schema for ERP Phase 1
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id           String   @id @default(cuid())
  customerId   String   @unique
  companyName  String
  gstin        String?
  city         String?
  contact      String?
  creditLimit  Decimal  @default(0)
  outstanding  Decimal  @default(0)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  invoices     Invoice[]
}

model Vendor {
  id          String   @id @default(cuid())
  vendorId    String   @unique
  companyName String
  category    String?
  leadTimeDays Int?
  outstanding Decimal @default(0)
  status      String  @default("active")
  createdAt   DateTime @default(now())
}

model Inventory {
  id           String   @id @default(cuid())
  skuId        String   @unique
  name         String
  type         String
  warehouse    String?
  unit         String?
  stock        Int      @default(0)
  reorderLevel Int      @default(0)
  averageCost  Decimal  @default(0)
  createdAt    DateTime @default(now())
}

model Invoice {
  id         String   @id @default(cuid())
  invoiceId  String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String
  issueDate  DateTime
  dueDate    DateTime
  status     String
  paidAmount Decimal  @default(0)
  total      Decimal  @default(0)
  items      InvoiceItem[]
  payments   Payment[]
  createdAt  DateTime @default(now())
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId String
  sku       Inventory @relation(fields: [skuId], references: [id])
  skuId     String
  description String?
  quantity  Int
  rate      Decimal
}

model Payment {
  id        String   @id @default(cuid())
  paymentId String   @unique
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  invoiceId String?
  vendor    Vendor?  @relation(fields: [vendorId], references: [id])
  vendorId  String?
  type      String
  amount    Decimal
  date      DateTime
  status    String
  createdAt DateTime @default(now())
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  poId        String   @unique
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  vendorId    String
  orderDate   DateTime
  expectedDate DateTime?
  status      String
  items       PurchaseOrderItem[]
  createdAt   DateTime @default(now())
}

model PurchaseOrderItem {
  id        String @id @default(cuid())
  po        PurchaseOrder @relation(fields: [poId], references: [id])
  poId      String
  sku       Inventory @relation(fields: [skuId], references: [id])
  skuId     String
  description String?
  quantity  Int
  rate      Decimal
}

model ProductionJob {
  id               String @id @default(cuid())
  jobId            String @unique
  product          Inventory @relation(fields: [productId], references: [id])
  productId        String
  plannedQuantity  Int
  completedQuantity Int @default(0)
  line             String
  status           String
  startDate        DateTime
  createdAt        DateTime @default(now())
}

model Expense {
  id        String @id @default(cuid())
  expenseId String @unique
  category  String
  amount    Decimal
  date      DateTime
  status    String
  createdAt DateTime @default(now())
}
