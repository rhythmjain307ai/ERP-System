generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model accounting_entry {
  accounting_entry_id BigInt          @id @default(autoincrement())
  entry_date          DateTime        @default(dbgenerated("CURRENT_DATE")) @db.Date
  source_type         String?
  source_id           BigInt?
  description         String?
  status              String          @default("POSTED")
  created_by          BigInt?
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  users               users?          @relation(fields: [created_by], references: [user_id], onUpdate: NoAction, map: "fk_accounting_entry_user")
  journal_entry       journal_entry[]
}

model accounts_payable {
  accounts_payable_id BigInt          @id @default(autoincrement())
  vendor_id           BigInt
  vendor_invoice_id   BigInt?         @unique
  expense_id          BigInt?
  due_date            DateTime?       @db.Date
  invoice_amount      Decimal         @default(0) @db.Decimal(16, 2)
  paid_amount         Decimal         @default(0) @db.Decimal(16, 2)
  outstanding_amount  Decimal         @default(0) @db.Decimal(16, 2)
  status              String          @default("OPEN")
  expense             expense?        @relation(fields: [expense_id], references: [expense_id], onUpdate: NoAction)
  vendor              vendor          @relation(fields: [vendor_id], references: [vendor_id], onUpdate: NoAction, map: "fk_ap_vendor")
  vendor_invoice      vendor_invoice? @relation(fields: [vendor_invoice_id], references: [vendor_invoice_id], onUpdate: NoAction, map: "fk_ap_invoice")

  @@index([vendor_id, status], map: "idx_payable_vendor_status")
}

model accounts_receivable {
  accounts_receivable_id BigInt         @id @default(autoincrement())
  customer_id            BigInt
  sales_invoice_id       BigInt?        @unique
  due_date               DateTime?      @db.Date
  invoice_amount         Decimal        @default(0) @db.Decimal(16, 2)
  received_amount        Decimal        @default(0) @db.Decimal(16, 2)
  outstanding_amount     Decimal        @default(0) @db.Decimal(16, 2)
  status                 String         @default("OPEN")
  customer               customer       @relation(fields: [customer_id], references: [customer_id], onUpdate: NoAction, map: "fk_ar_customer")
  sales_invoice          sales_invoice? @relation(fields: [sales_invoice_id], references: [sales_invoice_id], onUpdate: NoAction, map: "fk_ar_invoice")

  @@index([customer_id, status], map: "idx_receivable_customer_status")
}

model approval_action {
  approval_action_id   BigInt            @id @default(autoincrement())
  approval_workflow_id BigInt
  approval_step_id     BigInt?
  transaction_type     String
  transaction_id       BigInt
  action_by            BigInt?
  action               String
  action_at            DateTime          @default(now()) @db.Timestamptz(6)
  comments             String?
  users                users?            @relation(fields: [action_by], references: [user_id], onUpdate: NoAction)
  approval_step        approval_step?    @relation(fields: [approval_step_id], references: [approval_step_id], onUpdate: NoAction, map: "fk_approval_action_step")
  approval_workflow    approval_workflow @relation(fields: [approval_workflow_id], references: [approval_workflow_id], onDelete: Cascade, onUpdate: NoAction)
}

model approval_step {
  approval_step_id     BigInt            @id @default(autoincrement())
  approval_workflow_id BigInt
  step_number          Int
  role_id              BigInt?
  step_name            String
  is_mandatory         Boolean           @default(true)
  approval_action      approval_action[]
  approval_workflow    approval_workflow @relation(fields: [approval_workflow_id], references: [approval_workflow_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_approval_step_workflow")
  role                 role?             @relation(fields: [role_id], references: [role_id], onUpdate: NoAction, map: "fk_approval_step_role")

  @@unique([approval_workflow_id, step_number])
}

model approval_workflow {
  approval_workflow_id BigInt            @id @default(autoincrement())
  workflow_name        String            @unique
  transaction_type     String
  is_active            Boolean           @default(true)
  approval_action      approval_action[]
  approval_step        approval_step[]
}

model attendance {
  attendance_id   BigInt    @id @default(autoincrement())
  employee_id     BigInt
  attendance_date DateTime  @db.Date
  scheduled_hours Decimal   @default(0) @db.Decimal(6, 2)
  actual_hours    Decimal   @default(0) @db.Decimal(6, 2)
  overtime_hours  Decimal   @default(0) @db.Decimal(6, 2)
  deduction_hours Decimal   @default(0) @db.Decimal(6, 2)
  status          String    @default("PRESENT")
  check_in        DateTime? @db.Timestamptz(6)
  check_out       DateTime? @db.Timestamptz(6)
  remarks         String?
  employee        employee  @relation(fields: [employee_id], references: [employee_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_attendance_employee")

  @@unique([employee_id, attendance_date])
  @@index([attendance_date], map: "idx_attendance_date")
}

model audit_log {
  audit_log_id BigInt   @id @default(autoincrement())
  user_id      BigInt?
  action       String
  table_name   String
  record_id    BigInt?
  old_values   Json?
  new_values   Json?
  ip_address   String?  @db.Inet
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  users        users?   @relation(fields: [user_id], references: [user_id], onUpdate: NoAction, map: "fk_audit_log_user")

  @@index([table_name, record_id], map: "idx_audit_log_table_record")
}

model bank_account {
  bank_account_id  BigInt             @id @default(autoincrement())
  company_id       BigInt
  bank_name        String
  account_name     String?
  account_number   String
  ifsc_code        String?
  branch_name      String?
  opening_balance  Decimal            @default(0) @db.Decimal(16, 2)
  current_balance  Decimal            @default(0) @db.Decimal(16, 2)
  is_active        Boolean            @default(true)
  company          company            @relation(fields: [company_id], references: [company_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bank_account_company")
  bank_transaction bank_transaction[]
  payment          payment[]

  @@unique([company_id, account_number])
}

model bank_transaction {
  bank_transaction_id BigInt       @id @default(autoincrement())
  bank_account_id     BigInt
  payment_id          BigInt?
  transaction_date    DateTime     @default(dbgenerated("CURRENT_DATE")) @db.Date
  transaction_type    String
  amount              Decimal      @db.Decimal(16, 2)
  reference_number    String?
  description         String?
  running_balance     Decimal?     @db.Decimal(16, 2)
  bank_account        bank_account @relation(fields: [bank_account_id], references: [bank_account_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bank_transaction_account")
  payment             payment?     @relation(fields: [payment_id], references: [payment_id], onUpdate: NoAction)

  @@index([transaction_date], map: "idx_bank_transaction_date")
}

model bill_of_material {
  bom_id           BigInt         @id @default(autoincrement())
  finished_item_id BigInt
  bom_code         String         @unique
  version          String         @default("1")
  is_active        Boolean        @default(true)
  effective_from   DateTime?      @db.Date
  effective_to     DateTime?      @db.Date
  inventory_item   inventory_item @relation(fields: [finished_item_id], references: [inventory_item_id], onUpdate: NoAction)
  bom_item         bom_item[]

  @@unique([finished_item_id, version])
}

model bom_item {
  bom_item_id       BigInt           @id @default(autoincrement())
  bom_id            BigInt
  component_item_id BigInt
  quantity_per_unit Decimal          @db.Decimal(18, 6)
  uom               String           @db.VarChar(20)
  scrap_percentage  Decimal          @default(0) @db.Decimal(7, 3)
  bill_of_material  bill_of_material @relation(fields: [bom_id], references: [bom_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bom_item_bom")
  inventory_item    inventory_item   @relation(fields: [component_item_id], references: [inventory_item_id], onUpdate: NoAction)

  @@unique([bom_id, component_item_id])
}

model chart_of_account {
  account_id             BigInt             @id @default(autoincrement())
  account_code           String             @unique
  account_name           String
  account_type           String
  parent_account_id      BigInt?
  is_active              Boolean            @default(true)
  chart_of_account       chart_of_account?  @relation("chart_of_accountTochart_of_account", fields: [parent_account_id], references: [account_id], onUpdate: NoAction, map: "fk_chart_account_parent")
  other_chart_of_account chart_of_account[] @relation("chart_of_accountTochart_of_account")
  journal_line           journal_line[]
}

model company {
  company_id    BigInt         @id @default(autoincrement())
  company_name  String
  legal_name    String?
  gstin         String?        @unique @db.VarChar(15)
  pan           String?        @db.VarChar(10)
  cin           String?        @db.VarChar(21)
  email         String?
  phone         String?
  address_line1 String?
  address_line2 String?
  city          String?
  state         String?
  state_code    String?        @db.VarChar(5)
  pincode       String?        @db.VarChar(10)
  country       String         @default("India")
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @default(now()) @db.Timestamptz(6)
  bank_account  bank_account[]
  customer      customer[]
  department    department[]
  employee      employee[]
  factory       factory[]
  vendor        vendor[]
}

model customer {
  customer_id         BigInt                @id @default(autoincrement())
  company_id          BigInt
  customer_code       String
  customer_name       String
  gstin               String?               @db.VarChar(15)
  pan                 String?               @db.VarChar(10)
  email               String?
  phone               String?
  billing_address     String?
  shipping_address    String?
  city                String?
  state               String?
  state_code          String?               @db.VarChar(5)
  pincode             String?               @db.VarChar(10)
  payment_terms_days  Int                   @default(0)
  credit_limit        Decimal               @default(0) @db.Decimal(16, 2)
  is_active           Boolean               @default(true)
  accounts_receivable accounts_receivable[]
  company             company               @relation(fields: [company_id], references: [company_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_customer_company")
  customer_ledger     customer_ledger[]
  customer_order      customer_order[]
  delivery            delivery[]
  payment             payment[]
  sales_invoice       sales_invoice[]

  @@unique([company_id, customer_code])
  @@index([gstin], map: "idx_customer_gstin")
}

model customer_ledger {
  customer_ledger_id BigInt   @id @default(autoincrement())
  customer_id        BigInt
  transaction_date   DateTime @db.Date
  reference_type     String
  reference_id       BigInt?
  debit_amount       Decimal  @default(0) @db.Decimal(16, 2)
  credit_amount      Decimal  @default(0) @db.Decimal(16, 2)
  description        String?
  customer           customer @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_customer_ledger_customer")
}

model customer_order {
  customer_order_id   BigInt                @id @default(autoincrement())
  order_number        String                @unique
  customer_id         BigInt
  order_date          DateTime              @default(dbgenerated("CURRENT_DATE")) @db.Date
  buyer_order_number  String?
  buyer_order_date    DateTime?             @db.Date
  order_type          String                @default("SALES")
  payment_terms       String?
  bill_to_address     String?
  ship_to_address     String?
  consignee_name      String?
  consignee_address   String?
  place_of_supply     String?
  status              String                @default("OPEN")
  remarks             String?
  customer            customer              @relation(fields: [customer_id], references: [customer_id], onUpdate: NoAction, map: "fk_customer_order_customer")
  customer_order_item customer_order_item[]
  delivery            delivery[]
  job_work_order      job_work_order[]
  sales_invoice       sales_invoice[]

  @@index([customer_id, order_date], map: "idx_customer_order_customer_date")
}

model customer_order_item {
  customer_order_item_id BigInt               @id @default(autoincrement())
  customer_order_id      BigInt
  inventory_item_id      BigInt
  description            String?
  hsn_sac_code           String?              @db.VarChar(20)
  uom                    String               @db.VarChar(20)
  ordered_quantity       Decimal              @db.Decimal(18, 3)
  unit_rate              Decimal              @default(0) @db.Decimal(18, 4)
  gst_rate               Decimal              @default(0) @db.Decimal(6, 3)
  line_amount            Decimal              @default(0) @db.Decimal(16, 2)
  customer_order         customer_order       @relation(fields: [customer_order_id], references: [customer_order_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_customer_order_item_order")
  inventory_item         inventory_item       @relation(fields: [inventory_item_id], references: [inventory_item_id], onUpdate: NoAction)
  sales_invoice_item     sales_invoice_item[]
}

model delivery {
  delivery_id        BigInt               @id @default(autoincrement())
  delivery_number    String               @unique
  customer_id        BigInt
  customer_order_id  BigInt?
  sales_invoice_id   BigInt?
  warehouse_id       BigInt?
  delivery_date      DateTime             @default(dbgenerated("CURRENT_DATE")) @db.Date
  challan_number     String?
  transporter        String?
  vehicle_number     String?
  lr_number          String?
  destination        String?
  status             String               @default("DRAFT")
  remarks            String?
  customer           customer             @relation(fields: [customer_id], references: [customer_id], onUpdate: NoAction)
  customer_order     customer_order?      @relation(fields: [customer_order_id], references: [customer_order_id], onUpdate: NoAction, map: "fk_delivery_order")
  sales_invoice      sales_invoice?       @relation(fields: [sales_invoice_id], references: [sales_invoice_id], onUpdate: NoAction)
  warehouse          warehouse?           @relation(fields: [warehouse_id], references: [warehouse_id], onUpdate: NoAction, map: "fk_delivery_warehouse")
  weighbridge_ticket weighbridge_ticket[]

  @@index([customer_id, delivery_date], map: "idx_delivery_customer_date")
}

model department {
  department_id        BigInt                 @id @default(autoincrement())
  company_id           BigInt
  department_code      String
  department_name      String
  company              company                @relation(fields: [company_id], references: [company_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_department_company")
  employee             employee[]
  purchase_requisition purchase_requisition[]

  @@unique([company_id, department_code])
  @@unique([company_id, department_name])
}

model document {
  document_id    BigInt   @id @default(autoincrement())
  document_type  String
  reference_type String?
  reference_id   BigInt?
  file_name      String
  file_url       String?
  mime_type      String?
  uploaded_by    BigInt?
  uploaded_at    DateTime @default(now()) @db.Timestamptz(6)
  metadata       Json     @default("{}")
  users          users?   @relation(fields: [uploaded_by], references: [user_id], onUpdate: NoAction, map: "fk_document_uploaded_by")

  @@index([reference_type, reference_id], map: "idx_document_reference")
}

model employee {
  employee_id             BigInt                    @id @default(autoincrement())
  company_id              BigInt
  factory_id              BigInt?
  department_id           BigInt?
  employee_code           String
  first_name              String
  middle_name             String?
  last_name               String?
  designation             String?
  joining_date            DateTime?                 @db.Date
  leaving_date            DateTime?                 @db.Date
  employment_status       String                    @default("ACTIVE")
  pan                     String?                   @db.VarChar(10)
  pf_number               String?
  pt_number               String?
  bank_name               String?
  bank_account_number     String?
  bank_ifsc               String?
  scheduled_daily_hours   Decimal                   @default(8) @db.Decimal(5, 2)
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @default(now()) @db.Timestamptz(6)
  attendance              attendance[]
  company                 company                   @relation(fields: [company_id], references: [company_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_employee_company")
  department              department?               @relation(fields: [department_id], references: [department_id], onUpdate: NoAction, map: "fk_employee_department")
  factory                 factory?                  @relation(fields: [factory_id], references: [factory_id], onUpdate: NoAction, map: "fk_employee_factory")
  employee_salary_history employee_salary_history[]
  leave                   leave[]
  payroll                 payroll[]
  users                   users?

  @@unique([company_id, employee_code])
  @@index([department_id], map: "idx_employee_department")
  @@index([factory_id], map: "idx_employee_factory")
}

model expense {
  expense_id          BigInt             @id @default(autoincrement())
  expense_number      String             @unique
  vendor_id           BigInt?
  expense_category_id BigInt
  expense_date        DateTime           @default(dbgenerated("CURRENT_DATE")) @db.Date
  bill_number         String?
  bill_date           DateTime?          @db.Date
  payment_terms       String?
  taxable_amount      Decimal            @default(0) @db.Decimal(16, 2)
  cgst_amount         Decimal            @default(0) @db.Decimal(16, 2)
  sgst_amount         Decimal            @default(0) @db.Decimal(16, 2)
  igst_amount         Decimal            @default(0) @db.Decimal(16, 2)
  total_amount        Decimal            @default(0) @db.Decimal(16, 2)
  status              String             @default("DRAFT")
  remarks             String?
  accounts_payable    accounts_payable[]
  expense_category    expense_category   @relation(fields: [expense_category_id], references: [expense_category_id], onUpdate: NoAction, map: "fk_expense_category")
  vendor              vendor?            @relation(fields: [vendor_id], references: [vendor_id], onUpdate: NoAction, map: "fk_expense_vendor")
  expense_item        expense_item[]

  @@index([expense_category_id, expense_date], map: "idx_expense_category_date")
  @@index([expense_date], map: "idx_expense_date")
}

model expense_category {
  expense_category_id    BigInt             @id @default(autoincrement())
  category_name          String             @unique
  parent_category_id     BigInt?
  category_group         String             @default("OTHER_EXPENSE")
  description            String?
  expense                expense[]
  expense_category       expense_category?  @relation("expense_categoryToexpense_category", fields: [parent_category_id], references: [expense_category_id], onUpdate: NoAction, map: "fk_expense_category_parent")
  other_expense_category expense_category[] @relation("expense_categoryToexpense_category")
}

model factory {
  factory_id       BigInt             @id @default(autoincrement())
  company_id       BigInt
  factory_code     String
  factory_name     String
  gstin            String?            @db.VarChar(15)
  address_line1    String?
  address_line2    String?
  city             String?
  state            String?
  state_code       String?            @db.VarChar(5)
  pincode          String?            @db.VarChar(10)
  phone            String?
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  employee         employee[]
  company          company            @relation(fields: [company_id], references: [company_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_factory_company")
  job_work_order   job_work_order[]
  machine          machine[]
  production_order production_order[]
  warehouse        warehouse[]

  @@unique([company_id, factory_code])
}

model grn {
  grn_id                  BigInt               @id @default(autoincrement())
  grn_number              String               @unique
  purchase_order_id       BigInt?
  vendor_id               BigInt
  warehouse_id            BigInt
  vendor_invoice_id       BigInt?
  grn_date                DateTime             @default(dbgenerated("CURRENT_DATE")) @db.Date
  gate_entry_number       String?
  supplier_invoice_number String?
  challan_number          String?
  transporter             String?
  vehicle_number          String?
  lr_number               String?
  inspection_status       String               @default("PENDING")
  inspected_by            BigInt?
  inspection_date         DateTime?            @db.Date
  remarks                 String?
  users                   users?               @relation(fields: [inspected_by], references: [user_id], onUpdate: NoAction)
  purchase_order          purchase_order?      @relation(fields: [purchase_order_id], references: [purchase_order_id], onUpdate: NoAction, map: "fk_grn_po")
  vendor                  vendor               @relation(fields: [vendor_id], references: [vendor_id], onUpdate: NoAction)
  vendor_invoice          vendor_invoice?      @relation(fields: [vendor_invoice_id], references: [vendor_invoice_id], onUpdate: NoAction)
  warehouse               warehouse            @relation(fields: [warehouse_id], references: [warehouse_id], onUpdate: NoAction, map: "fk_grn_warehouse")
  grn_item                grn_item[]
  weighbridge_ticket      weighbridge_ticket[]

  @@index([vendor_id, grn_date], map: "idx_grn_vendor_date")
}

model grn_item {
  grn_item_id            BigInt               @id @default(autoincrement())
  grn_id                 BigInt
  purchase_order_item_id BigInt?
  inventory_item_id      BigInt
  lot_id                 BigInt?
  heat_number            String?
  uom                    String               @db.VarChar(20)
  challan_quantity       Decimal              @default(0) @db.Decimal(18, 3)
  received_quantity      Decimal              @default(0) @db.Decimal(18, 3)
  accepted_quantity      Decimal              @default(0) @db.Decimal(18, 3)
  rejected_quantity      Decimal              @default(0) @db.Decimal(18, 3)
  rejection_reason       String?
  rate                   Decimal              @default(0) @db.Decimal(18, 4)
  grn                    grn                  @relation(fields: [grn_id], references: [grn_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_grn_item_grn")
  inventory_item         inventory_item       @relation(fields: [inventory_item_id], references: [inventory_item_id], onUpdate: NoAction)
  inventory_lot          inventory_lot?       @relation(fields: [lot_id], references: [lot_id], onUpdate: NoAction)
  purchase_order_item    purchase_order_item? @relation(fields: [purchase_order_item_id], references: [purchase_order_item_id], onUpdate: NoAction)

  @@index([heat_number], map: "idx_grn_item_heat")
}

model inventory_item {
  inventory_item_id      BigInt                   @id @default(autoincrement())
  item_category_id       BigInt?
  item_code              String                   @unique
  item_name              String
  description            String?
  item_type              String                   @default("OTHER")
  hsn_sac_code           String?                  @db.VarChar(20)
  base_uom               String                   @db.VarChar(20)
  gst_rate               Decimal                  @default(0) @db.Decimal(6, 3)
  is_stock_item          Boolean                  @default(true)
  is_lot_tracked         Boolean                  @default(false)
  is_active              Boolean                  @default(true)
  bill_of_material       bill_of_material[]
  bom_item               bom_item[]
  customer_order_item    customer_order_item[]
  expense_item           expense_item[]
  grn_item               grn_item[]
  item_category          item_category?           @relation(fields: [item_category_id], references: [item_category_id], onUpdate: NoAction, map: "fk_inventory_item_category")
  inventory_lot          inventory_lot[]
  inventory_stock        inventory_stock[]
  job_work_challan_item  job_work_challan_item[]
  job_work_receipt_item  job_work_receipt_item[]
  production_consumption production_consumption[]
  production_order       production_order[]
  production_output      production_output[]
  purchase_order_item    purchase_order_item[]
  sales_invoice_item     sales_invoice_item[]
  stock_movement         stock_movement[]
  vendor_invoice_item    vendor_invoice_item[]

  @@index([item_category_id], map: "idx_inventory_item_category")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_stock {
  inventory_stock_id BigInt         @id @default(autoincrement())
  inventory_item_id  BigInt
  warehouse_id       BigInt
  lot_id             BigInt?
  quantity           Decimal        @default(0) @db.Decimal(18, 3)
  reserved_quantity  Decimal        @default(0) @db.Decimal(18, 3)
  last_updated_at    DateTime       @default(now()) @db.Timestamptz(6)
