generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model accounting_entry {
  accounting_entry_id                                                   BigInt           @id @default(autoincrement())
  company_id                                                            BigInt
  transaction_date                                                      DateTime         @default(now()) @db.Timestamptz(6)
  reference_type                                                        String?
  reference_id                                                          BigInt?
  debit_account_id                                                      BigInt
  credit_account_id                                                     BigInt
  amount                                                                Decimal          @db.Decimal(14, 2)
  description                                                           String?
  created_by                                                            BigInt?
  company                                                               company          @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_accounting_entry_company")
  chart_of_account_accounting_entry_credit_account_idTochart_of_account chart_of_account @relation("accounting_entry_credit_account_idTochart_of_account", fields: [credit_account_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_accounting_entry_credit")
  chart_of_account_accounting_entry_debit_account_idTochart_of_account  chart_of_account @relation("accounting_entry_debit_account_idTochart_of_account", fields: [debit_account_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_accounting_entry_debit")
  users                                                                 users?           @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_accounting_entry_user")

  @@index([transaction_date], map: "idx_accounting_entry_date")
}

model accounts_payable {
  accounts_payable_id BigInt          @id @default(autoincrement())
  vendor_id           BigInt
  vendor_invoice_id   BigInt?
  invoice_date        DateTime?       @db.Date
  due_date            DateTime?       @db.Date
  invoice_amount      Decimal         @db.Decimal(14, 2)
  paid_amount         Decimal         @default(0) @db.Decimal(14, 2)
  status              String          @default("OPEN")
  vendor_invoice      vendor_invoice? @relation(fields: [vendor_invoice_id], references: [vendor_invoice_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ap_invoice")
  vendor              vendor          @relation(fields: [vendor_id], references: [vendor_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ap_vendor")
}

model accounts_receivable {
  accounts_receivable_id BigInt         @id @default(autoincrement())
  customer_id            BigInt
  sales_invoice_id       BigInt?
  invoice_date           DateTime?      @db.Date
  due_date               DateTime?      @db.Date
  invoice_amount         Decimal        @db.Decimal(14, 2)
  received_amount        Decimal        @default(0) @db.Decimal(14, 2)
  status                 String         @default("OPEN")
  customer               customer       @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ar_customer")
  sales_invoice          sales_invoice? @relation(fields: [sales_invoice_id], references: [sales_invoice_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ar_invoice")
}

model approval_action {
  approval_action_id BigInt        @id @default(autoincrement())
  approval_step_id   BigInt
  user_id            BigInt
  action             String
  action_date        DateTime      @default(now()) @db.Timestamptz(6)
  comments           String?
  approval_step      approval_step @relation(fields: [approval_step_id], references: [approval_step_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_approval_action_step")
  users              users         @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_approval_action_user")
}

model approval_step {
  approval_step_id     BigInt            @id @default(autoincrement())
  approval_workflow_id BigInt
  step_number          Int
  role_id              BigInt
  status               String            @default("PENDING")
  approval_action      approval_action[]
  role                 role              @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_approval_step_role")
  approval_workflow    approval_workflow @relation(fields: [approval_workflow_id], references: [approval_workflow_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_approval_step_workflow")

  @@unique([approval_workflow_id, step_number], map: "uq_approval_step")
}

model approval_workflow {
  approval_workflow_id BigInt          @id @default(autoincrement())
  workflow_name        String
  transaction_type     String
  transaction_id       BigInt
  current_step         Int             @default(1)
  status               String          @default("PENDING")
  created_at           DateTime        @default(now()) @db.Timestamptz(6)
  approval_step        approval_step[]

  @@unique([transaction_type, transaction_id], map: "uq_approval_transaction")
}

model attendance {
  attendance_id   BigInt   @id @default(autoincrement())
  employee_id     BigInt
  attendance_date DateTime @db.Date
  scheduled_hours Decimal? @db.Decimal(8, 2)
  actual_hours    Decimal? @db.Decimal(8, 2)
  overtime_hours  Decimal  @default(0) @db.Decimal(8, 2)
  status          String?
  remarks         String?
  employee        employee @relation(fields: [employee_id], references: [employee_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_attendance_employee")

  @@unique([employee_id, attendance_date], map: "uq_attendance_employee_date")
  @@index([employee_id, attendance_date], map: "idx_attendance_employee_date")
}

model audit_log {
  audit_log_id BigInt   @id @default(autoincrement())
  user_id      BigInt?
  table_name   String
  record_id    BigInt?
  action       String
  old_values   Json?
  new_values   Json?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  users        users?   @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_log_user")

  @@index([table_name, record_id], map: "idx_audit_log_table_record")
}

model bank_account {
  bank_account_id  BigInt             @id @default(autoincrement())
  company_id       BigInt
  bank_name        String
  account_name     String?
  account_number   String?
  ifsc_code        String?
  opening_balance  Decimal            @default(0) @db.Decimal(14, 2)
  current_balance  Decimal            @default(0) @db.Decimal(14, 2)
  company          company            @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bank_account_company")
  bank_transaction bank_transaction[]
  payment          payment[]
}

model bank_transaction {
  bank_transaction_id BigInt       @id @default(autoincrement())
  bank_account_id     BigInt
  transaction_date    DateTime     @default(now()) @db.Timestamptz(6)
  transaction_type    String
  amount              Decimal      @db.Decimal(14, 2)
  reference_number    String?
  description         String?
  bank_account        bank_account @relation(fields: [bank_account_id], references: [bank_account_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bank_transaction_account")
}

model bill_of_material {
  bom_id          BigInt         @id @default(autoincrement())
  product_item_id BigInt
  version         String
  is_active       Boolean        @default(true)
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  inventory_item  inventory_item @relation(fields: [product_item_id], references: [item_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bom_product")
  bom_item        bom_item[]

  @@unique([product_item_id, version], map: "uq_bom_product_version")
}

model bom_item {
  bom_item_id          BigInt           @id @default(autoincrement())
  bom_id               BigInt
  raw_material_item_id BigInt
  quantity_required    Decimal          @db.Decimal(14, 3)
  unit_of_measure      String?
  bill_of_material     bill_of_material @relation(fields: [bom_id], references: [bom_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bom_item_bom")
  inventory_item       inventory_item   @relation(fields: [raw_material_item_id], references: [item_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bom_item_raw_material")
}

model chart_of_account {
  account_id                                                            BigInt             @id @default(autoincrement())
  company_id                                                            BigInt
  parent_account_id                                                     BigInt?
  account_code                                                          String
  account_name                                                          String
  account_type                                                          String
  is_active                                                             Boolean            @default(true)
  accounting_entry_accounting_entry_credit_account_idTochart_of_account accounting_entry[] @relation("accounting_entry_credit_account_idTochart_of_account")
  accounting_entry_accounting_entry_debit_account_idTochart_of_account  accounting_entry[] @relation("accounting_entry_debit_account_idTochart_of_account")
  company                                                               company            @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_chart_account_company")
  chart_of_account                                                      chart_of_account?  @relation("chart_of_accountTochart_of_account", fields: [parent_account_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_chart_account_parent")
  other_chart_of_account                                                chart_of_account[] @relation("chart_of_accountTochart_of_account")
  journal_line                                                          journal_line[]

  @@unique([company_id, account_code], map: "uq_chart_account_company_code")
}

model company {
  company_id           BigInt                 @id @default(autoincrement())
  company_name         String
  address              String?
  city                 String?
  state                String?
  country              String?
  phone                String?
  email                String?
  tax_id               String?
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  accounting_entry     accounting_entry[]
  bank_account         bank_account[]
  chart_of_account     chart_of_account[]
  customer             customer[]
  customer_order       customer_order[]
  department           department[]
  employee             employee[]
  expense              expense[]
  factory              factory[]
  inventory_item       inventory_item[]
  journal_entry        journal_entry[]
  payment              payment[]
  production_order     production_order[]
  purchase_order       purchase_order[]
  purchase_requisition purchase_requisition[]
  vendor               vendor[]
}

model customer {
  customer_id         BigInt                @id @default(autoincrement())
  company_id          BigInt
  customer_code       String
  customer_name       String
  contact_person      String?
  phone               String?
  email               String?
  address             String?
  city                String?
  state               String?
  tax_id              String?
  credit_limit        Decimal?              @db.Decimal(14, 2)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  accounts_receivable accounts_receivable[]
  company             company               @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_customer_company")
  customer_ledger     customer_ledger[]
  customer_order      customer_order[]
  payment             payment[]
  sales_invoice       sales_invoice[]

  @@unique([company_id, customer_code], map: "uq_customer_company_code")
}

model customer_ledger {
  customer_ledger_id BigInt   @id @default(autoincrement())
  customer_id        BigInt
  transaction_date   DateTime @default(now()) @db.Timestamptz(6)
  transaction_type   String
  reference_id       BigInt?
  debit_amount       Decimal  @default(0) @db.Decimal(14, 2)
  credit_amount      Decimal  @default(0) @db.Decimal(14, 2)
  description        String?
  customer           customer @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_customer_ledger_customer")
}

model customer_order {
  customer_order_id   BigInt                @id @default(autoincrement())
  company_id          BigInt
  factory_id          BigInt?
  customer_id         BigInt
  order_number        String
  order_date          DateTime              @default(dbgenerated("CURRENT_DATE")) @db.Date
  delivery_date       DateTime?             @db.Date
  status              String                @default("PENDING")
  subtotal            Decimal               @default(0) @db.Decimal(14, 2)
  tax_amount          Decimal               @default(0) @db.Decimal(14, 2)
  total_amount        Decimal               @default(0) @db.Decimal(14, 2)
  company             company               @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_customer_order_company")
  customer            customer              @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_customer_order_customer")
  factory             factory?              @relation(fields: [factory_id], references: [factory_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_customer_order_factory")
  customer_order_item customer_order_item[]
  delivery            delivery[]
  sales_invoice       sales_invoice[]

  @@unique([company_id, order_number], map: "uq_customer_order_company_number")
  @@index([customer_id], map: "idx_customer_order_customer")
}

model customer_order_item {
  customer_order_item_id BigInt         @id @default(autoincrement())
  customer_order_id      BigInt
  item_id                BigInt
  quantity               Decimal        @db.Decimal(14, 3)
  unit_price             Decimal        @db.Decimal(14, 2)
  tax_amount             Decimal        @default(0) @db.Decimal(14, 2)
  total_amount           Decimal        @db.Decimal(14, 2)
  inventory_item         inventory_item @relation(fields: [item_id], references: [item_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_customer_order_item_item")
  customer_order         customer_order @relation(fields: [customer_order_id], references: [customer_order_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_customer_order_item_order")
}

model delivery {
  delivery_id       BigInt         @id @default(autoincrement())
  customer_order_id BigInt
  warehouse_id      BigInt?
  delivery_number   String         @unique
  delivery_date     DateTime       @default(dbgenerated("CURRENT_DATE")) @db.Date
  status            String         @default("PENDING")
  remarks           String?
  customer_order    customer_order @relation(fields: [customer_order_id], references: [customer_order_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_delivery_order")
  warehouse         warehouse?     @relation(fields: [warehouse_id], references: [warehouse_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_delivery_warehouse")
}

model department {
  department_id   BigInt     @id @default(autoincrement())
  company_id      BigInt
  department_name String
  description     String?
  company         company    @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_department_company")
  employee        employee[]
}

model document {
  document_id    BigInt   @id @default(autoincrement())
  uploaded_by    BigInt?
  document_type  String?
  reference_type String?
  reference_id   BigInt?
  file_name      String
  file_path      String
  mime_type      String?
  uploaded_at    DateTime @default(now()) @db.Timestamptz(6)
  users          users?   @relation(fields: [uploaded_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_document_uploaded_by")
}

model employee {
  employee_id             BigInt       @id @default(autoincrement())
  company_id              BigInt
  factory_id              BigInt?
  department_id           BigInt?
  employee_code           String
  first_name              String
  last_name               String?
  email                   String?
  phone                   String?
  designation             String?
  joining_date            DateTime?    @db.Date
  employment_status       String       @default("ACTIVE")
  basic_salary            Decimal?     @db.Decimal(14, 2)
  pf_amount               Decimal?     @db.Decimal(14, 2)
  pt_amount               Decimal?     @db.Decimal(14, 2)
  scheduled_working_hours Decimal?     @db.Decimal(8, 2)
  created_at              DateTime     @default(now()) @db.Timestamptz(6)
  attendance              attendance[]
  company                 company      @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_employee_company")
  department              department?  @relation(fields: [department_id], references: [department_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_employee_department")
  factory                 factory?     @relation(fields: [factory_id], references: [factory_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_employee_factory")
  leave                   leave[]
  payroll                 payroll[]
  users                   users?
  work_order              work_order[]

  @@unique([company_id, employee_code], map: "uq_employee_company_code")
  @@index([department_id], map: "idx_employee_department")
  @@index([factory_id], map: "idx_employee_factory")
}

model expense {
  expense_id          BigInt           @id @default(autoincrement())
  company_id          BigInt
  factory_id          BigInt?
  expense_category_id BigInt
  vendor_id           BigInt?
  submitted_by        BigInt?
  expense_date        DateTime         @default(dbgenerated("CURRENT_DATE")) @db.Date
  description         String?
  amount              Decimal          @db.Decimal(14, 2)
  status              String           @default("PENDING")
  expense_category    expense_category @relation(fields: [expense_category_id], references: [expense_category_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_expense_category")
  company             company          @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_expense_company")
  factory             factory?         @relation(fields: [factory_id], references: [factory_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_expense_factory")
  users               users?           @relation(fields: [submitted_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_expense_submitted_by")
  vendor              vendor?          @relation(fields: [vendor_id], references: [vendor_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_expense_vendor")

  @@index([expense_category_id], map: "idx_expense_category")
}

model expense_category {
  expense_category_id    BigInt             @id @default(autoincrement())
  category_name          String             @unique
  parent_category_id     BigInt?
  description            String?
  expense                expense[]
  expense_category       expense_category?  @relation("expense_categoryToexpense_category", fields: [parent_category_id], references: [expense_category_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_expense_category_parent")
  other_expense_category expense_category[] @relation("expense_categoryToexpense_category")
}

model factory {
  factory_id           BigInt                 @id @default(autoincrement())
  company_id           BigInt
  factory_name         String
  address              String?
  city                 String?
  state                String?
  country              String?
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  customer_order       customer_order[]
  employee             employee[]
  expense              expense[]
  company              company                @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_factory_company")
  machine              machine[]
  production_order     production_order[]
  purchase_order       purchase_order[]
  purchase_requisition purchase_requisition[]
  warehouse            warehouse[]
}

model grn {
  grn_id            BigInt          @id @default(autoincrement())
  purchase_order_id BigInt?
  warehouse_id      BigInt
  received_by       BigInt?
  grn_number        String          @unique
  received_date     DateTime        @default(dbgenerated("CURRENT_DATE")) @db.Date
  status            String          @default("RECEIVED")
  remarks           String?
  purchase_order    purchase_order? @relation(fields: [purchase_order_id], references: [purchase_order_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_grn_po")
  users             users?          @relation(fields: [received_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_grn_received_by")
  warehouse         warehouse       @relation(fields: [warehouse_id], references: [warehouse_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_grn_warehouse")
  grn_item          grn_item[]

  @@index([purchase_order_id], map: "idx_grn_po")
}

model grn_item {
  grn_item_id       BigInt         @id @default(autoincrement())
  grn_id            BigInt
  item_id           BigInt
  ordered_quantity  Decimal?       @db.Decimal(14, 3)
  received_quantity Decimal        @db.Decimal(14, 3)
  accepted_quantity Decimal?       @db.Decimal(14, 3)
  rejected_quantity Decimal        @default(0) @db.Decimal(14, 3)
  grn               grn            @relation(fields: [grn_id], references: [grn_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_grn_item_grn")
  inventory_item    inventory_item @relation(fields: [item_id], references: [item_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_grn_item_item")
}

model inventory_item {
  item_id                BigInt                   @id @default(autoincrement())
  company_id             BigInt
  item_category_id       BigInt?
  item_code              String
  item_name              String
  description            String?
  unit_of_measure        String
  item_type              String
  standard_cost          Decimal?                 @db.Decimal(14, 2)
  reorder_level          Decimal?                 @default(0) @db.Decimal(14, 3)
  is_active              Boolean                  @default(true)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  bill_of_material       bill_of_material[]
  bom_item               bom_item[]
  customer_order_item    customer_order_item[]
  grn_item               grn_item[]
  item_category          item_category?           @relation(fields: [item_category_id], references: [item_category_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_inventory_item_category")
  company                company                  @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_inventory_item_company")
  inventory_stock        inventory_stock[]
  production_consumption production_consumption[]
  production_order       production_order[]
  production_output      production_output[]
  purchase_order_item    purchase_order_item[]
  stock_movement         stock_movement[]

  @@unique([company_id, item_code], map: "uq_inventory_item_company_code")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_stock {
  inventory_stock_id BigInt         @id @default(autoincrement())
  item_id            BigInt
  warehouse_id       BigInt
  quantity           Decimal        @default(0) @db.Decimal(14, 3)
  reserved_quantity  Decimal        @default(0) @db.Decimal(14, 3)
  updated_at         DateTime       @default(now()) @db.Timestamptz(6)
  inventory_item     inventory_item @relation(fields: [item_id], references: [item_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_inventory_stock_item")
  warehouse          warehouse      @relation(fields: [warehouse_id], references: [warehouse_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_inventory_stock_warehouse")

  @@unique([item_id, warehouse_id], map: "uq_inventory_stock_item_warehouse")
  @@index([item_id], map: "idx_inventory_stock_item")
  @@index([warehouse_id], map: "idx_inventory_stock_warehouse")
}

model item_category {
  item_category_id BigInt           @id @default(autoincrement())
  category_name    String           @unique
  description      String?
  inventory_item   inventory_item[]
}

model journal_entry {
  journal_entry_id BigInt         @id @default(autoincrement())
  company_id       BigInt
  entry_number     String
  entry_date       DateTime       @default(dbgenerated("CURRENT_DATE")) @db.Date
  description      String?
  status           String         @default("DRAFT")
  created_by       BigInt?
  company          company        @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_journal_entry_company")
  users            users?         @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_journal_entry_user")
  journal_line     journal_line[]

  @@unique([company_id, entry_number], map: "uq_journal_entry_company_number")
  @@index([entry_date], map: "idx_journal_entry_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model journal_line {
  journal_line_id  BigInt           @id @default(autoincrement())
  journal_entry_id BigInt
  account_id       BigInt
  debit_amount     Decimal          @default(0) @db.Decimal(14, 2)
  credit_amount    Decimal          @default(0) @db.Decimal(14, 2)
  description      String?
  chart_of_account chart_of_account @relation(fields: [account_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_journal_line_account")
